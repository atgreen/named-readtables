(require :asdf)
(asdf:load-system "named-readtables")
(named-readtables:defreadtable egcl-smoke (:merge :standard))
(assert (readtablep (named-readtables:find-readtable 'egcl-smoke)))
(let ((*readtable* (named-readtables:find-readtable 'egcl-smoke)))
  (assert (equal '(a 42) (read-from-string "(a 42)"))))
(assert (named-readtables:unregister-readtable 'egcl-smoke))
(let* ((source (copy-readtable nil))
       (destination (copy-readtable nil))
       (char (code-char #x03bb))
       (reader (lambda (stream character) (declare (ignore stream character)) :unicode))
       (dispatch (lambda (stream character argument) (declare (ignore stream character argument)) :dispatch)))
  (set-macro-character char reader nil source)
  (make-dispatch-macro-character #\! t source)
  (set-dispatch-macro-character #\! #\Q dispatch source)
  (make-dispatch-macro-character #\@ nil source)
  (named-readtables:merge-readtables-into destination source)
  (assert (eq reader (get-macro-character char destination)))
  (assert (eq dispatch (get-dispatch-macro-character #\! #\q destination)))
  (assert (nth-value 1 (get-macro-character #\! destination)))
  (assert (null (get-dispatch-macro-character #\@ #\Q destination))))
(format t "EGCL named-readtables smoke passed.~%")
